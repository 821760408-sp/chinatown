---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---

<Base title="Work" description="Selected projects.">
  <h1>Work</h1>
  <p class="lede">Selected projects.</p>
  <ul class="list">
    {projects.map((p) => (
      <li>
        <a href={url(`/projects/${p.id}/`)}>{p.data.title}</a>
        <span class="meta"> · {p.data.year}</span>
        <p>{p.data.summary}</p>
      </li>
    ))}
  </ul>
</Base>
